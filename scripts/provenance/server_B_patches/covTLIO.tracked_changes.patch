+def loss_distribution_covariance(pred_mean, pred_V, pred_inv, targ,
+                                        min_log_std=MIN_LOG_STD,
+                                        add_const=False):
+    """
+    NLL treating pred_inv as per-dim log(sigma).
+    pred_mean: (B,D)
+    pred_V:    (B,D,D)  orthonormal basis
+    pred_inv:  (B,D)    log(sigma) for each basis direction
+    targ:      (B,D)
+    returns: scalar mean NLL over batch
+    """
+    B, D = pred_mean.shape
+
+    # 1) clamp predicted log-std for numerical stability
+    pred_logstd = pred_inv   # (B,D)
+    # pred_logstd = torch.clamp(pred_inv, min=min_log_std)   # (B,D)
+    var = torch.exp(2.0 * pred_logstd)                     # sigma^2, (B,D)
+
+    # 2) project residual into V-basis: r' = V^T (targ - mean)
+    
+    residual = (targ - pred_mean).unsqueeze(-1)            # (B,D,1)
+    r_proj = torch.matmul(pred_V.transpose(1, 2), residual).squeeze(-1)  # (B,D)
+
+    # 3) per-dimension NLL (same scaling as your diag loss)
+    #    (r'^2) / (2 * sigma^2) + log(sigma)
+    per_dim = 0.5 * (r_proj ** 2) / var + pred_logstd     # (B,D)
