     return loss_per_axis
+
+def loss_distribution_from_skew_L_combined(pred, pred_logstd, targ, alpha=0.5, beta=1.0):
+    """
+    pred: predicted means, shape [B, ...]
+    pred_logstd: vector v from which covariance is built, shape [B, D]
+    targ: ground truth
+    alpha, beta: scalars for covariance construction
+
+    Returns:
+      N shape, N : Batch size
+    """
+
+    # v vector for covariance, shape [B, D]
+    v = pred_logstd  
+    # Outer product vv^T: [B, D, D]
+    vvT = torch.einsum('bi,bj->bij', v, v) 
+
+    # norm squared of v, shape [B, 1]
+    norm_v_sq = torch.sum(v ** 2, dim=1, keepdim=True)  
+
+    # Identity matrix [D, D], broadcasted to [B, D, D]
+    I = torch.eye(v.size(1), device=v.device).unsqueeze(0).expand(v.size(0), -1, -1)  
+
+    # Covariance matrix Σ
+    Sigma = alpha * vvT + beta * (norm_v_sq.unsqueeze(-1) * I - vvT)  
+
+    # Now compute your distribution loss, e.g. negative log likelihood
+    # For example (pseudo code, adapt based on your actual loss):
+    dist = torch.distributions.MultivariateNormal(pred, covariance_matrix=Sigma)
+    loss = -dist.log_prob(targ).mean()
+
+    return loss
+
+def loss_distribution_per_axis_from_skew_L(pred, pred_logstd, targ, alpha=0.5, beta=1.0):
+    """
+    Computes per-axis NLL loss given full covariance constructed from skewed v vector.
+    
+    Args:
+        pred: [B, 3] predicted mean
+        pred_logstd: [B, 3] vector used to construct covariance
+        targ: [B, 3] ground truth
+        alpha, beta: scalar weights for anisotropic vs isotropic terms
+    
+    Returns:
+        per_axis_loss: [B, 3] negative log-likelihood per axis
+    """
+    B, D = pred.shape
+    v = pred_logstd  # [B, 3]
+
+    # Construct full covariance matrix [B, 3, 3]
+    vvT = torch.einsum('bi,bj->bij', v, v)  # [B, 3, 3]
+    norm_v_sq = torch.sum(v ** 2, dim=1, keepdim=True)  # [B, 1]
+    I = torch.eye(D, device=v.device).unsqueeze(0).expand(B, -1, -1)  # [B, 3, 3]
+
+    Sigma = alpha * vvT + beta * (norm_v_sq.unsqueeze(-1) * I - vvT)  # [B, 3, 3]
+
+    # Cholesky for stability
+    dist = torch.distributions.MultivariateNormal(pred, covariance_matrix=Sigma)
+
+    # Log probability of full vector
+    log_probs = dist.log_prob(targ)  # [B]
+
+    # Compute Mahalanobis manually for per-axis contributions
+    # Δ = targ - pred
+    delta = targ - pred  # [B, 3]
+    Sigma_inv = torch.linalg.inv(Sigma)  # [B, 3, 3]
+
+    # Mahalanobis component-wise: [B, 3]
+    # Each axis i: loss_i = (delta * Sigma_inv * delta)[i]
+    axis_losses = torch.einsum('bi,bij,bj->b', delta, Sigma_inv, delta)  # [B] total Mahalanobis
+    total_logdet = torch.logdet(Sigma)  # [B]
+
+    # Full NLL = 0.5 * (Mahalanobis + log(det(Σ)) + D * log(2π))
+    # But we want **per-axis contribution**, so we decompose Mahalanobis
+    per_axis_loss = torch.einsum('bi,bij->bj', delta, Sigma_inv) * delta  # [B, 3]
+    per_axis_loss = 0.5 * per_axis_loss  # scale like NLL
+
+    return per_axis_loss  # shape: [B, 3]
+
